{
  "version": 2,
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs?__route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
